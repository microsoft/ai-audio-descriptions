# AI Audio Descriptions Environment Configuration
# This file contains example environment variables needed for the application
# DO NOT commit real values to source control

# Azure AI Services Configuration (for Content Understanding, Speech, etc.)
VITE_AI_SERVICES_RESOURCE=your-ai-services-name
VITE_AI_SERVICES_KEY=your-ai-services-key-here
VITE_AI_SERVICES_REGION=westus

# Azure OpenAI Configuration (for GPT models)
VITE_OPENAI_RESOURCE=your-openai-resource-name
VITE_OPENAI_KEY=your-openai-key-here
VITE_OPENAI_REGION=westus

# Azure Storage Configuration  
VITE_STORAGE_ACCOUNT=your-storage-account-name
VITE_BLOB_SAS_TOKEN=sp=racwdl&st=2024-01-01T00:00:00Z&se=2025-01-01T00:00:00Z&spr=https&sv=2022-11-02&sr=c&sig=your-signature-here

# GPT Model Deployment
VITE_GPT_DEPLOYMENT=gpt-4o